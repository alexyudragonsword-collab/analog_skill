* ============================================================
* FinFET output -- PMOS |Vsd| sweep at fixed |Vsg|  (BSIM-CMG via OSDI)
* L = {l_um} um   NFIN = {nfin}   |Vsg| = {vsg_v} V
* Source at VDD; drain swept from VDD down so |Vsd| = VDD - Vd.
* ============================================================

.include "{model_path}"

Vg g 0 DC {vg_v}
Vs s 0 DC {vdd_v}
Vd d 0 DC {vdd_v}

N1 d g s s {model} L={l_um}u NFIN={nfin}

.options reltol=1e-6 vntol=1e-9 abstol=1e-13
.temp 27

.control
  pre_osdi '{osdi_path}'
  save all @n1[gds]
  dc Vd {vdd_v} {vd_stop} {vd_step}
  wrdata '{dat_path}' i(Vd) @n1[gds]
  quit
.endc

.end
